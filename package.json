{
  "name": "hmo-access",
  "version": "0.1.0",
  "private": true,
  "description": "HMO Access — no-app, multi-HMO benefits verification, authorization and provider settlement platform (MVP)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "db:reset": "tsx --env-file=.env scripts/reset-db.ts && npm run db:migrate && npm run db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:e2e": "tsx --env-file=.env scripts/e2e-demo.ts",
    "audit:deps": "npm audit --omit=dev",
    "db:generate": "drizzle-kit generate",
    "db:preflight": "tsx --env-file=.env scripts/db-preflight.ts",
    "worker": "tsx --env-file=.env scripts/worker.ts",
    "admin:create": "tsx --env-file=.env scripts/create-platform-admin.ts",
    "housekeeping": "tsx --env-file=.env scripts/housekeeping.ts",
    "setup": "tsx scripts/setup.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "jsqr": "^1.4.0",
    "libphonenumber-js": "^1.13.15",
    "next": "^16.4.2",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
