# ---- Database ----
# Port 55432 = the Docker database from docker-compose.yml.
# Using your own PostgreSQL instead? Change 55432 to its port (usually 5432) here AND in .env.test.
DATABASE_URL="postgresql://hmo:hmo_dev_password@127.0.0.1:55432/hmo_access_dev"

# ---- Secrets (generate with: openssl rand -base64 32) ----
# Used to HMAC OTP codes, credential tokens and phone lookups. Rotate via documented procedure.
APP_HMAC_SECRET="replace-with-32+-random-bytes-base64"
# 32-byte key, base64. Encrypts member phone numbers at the application layer (AES-256-GCM).
FIELD_ENCRYPTION_KEY="replace-with-32-random-bytes-base64"

# ---- Public URL used in receipts / QR member links ----
APP_BASE_URL="http://localhost:3000"

# ---- SMS ----
# SMS_MODE: auto (default) | simulate | live | off
#   auto     -> simulate in development/test, live in production builds
#   simulate -> nothing is sent; texts appear in the phone simulator at /simulator
#   live     -> send through SMS_LIVE_PROVIDER
#   off      -> every send fails (fail-closed)
# In development, texts are ALWAYS simulated — even if the Termii keys below are filled in —
# unless SMS_MODE=live AND SMS_ALLOW_LIVE_IN_DEVELOPMENT=true.
SMS_MODE="auto"
SMS_LIVE_PROVIDER="termii"
SMS_ALLOW_LIVE_IN_DEVELOPMENT="false"
# Staging/demo only: allow a production build to simulate (a banner shows on every page).
SMS_ALLOW_SIMULATION_IN_PRODUCTION="false"
# Development only: make every SMS code this value (e.g. "123456") so testers don't need the simulator.
# Leave empty for random codes. Refused in production builds.
DEV_FIXED_OTP=""
TERMII_API_KEY=""
TERMII_SENDER_ID=""
TERMII_BASE_URL="https://api.ng.termii.com"

# ---- Security tuning ----
SESSION_TTL_HOURS="12"
OTP_TTL_SECONDS="300"
OTP_MAX_ATTEMPTS="5"
OTP_RESEND_COOLDOWN_SECONDS="60"
